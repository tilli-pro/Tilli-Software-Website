    <script src="script.js"></script>
    <script>
        // Commercial email domains to block
        const CONSUMER_EMAIL_DOMAINS = [
            'gmail.com', 'yahoo.com', 'hotmail.com', 'outlook.com', 'aol.com',
            'icloud.com', 'mail.com', 'protonmail.com', 'yandex.com', 'zoho.com'
        ];

        // Plan definitions (matching wizard)
        const PLANS = {
            trial: { name: 'Trial', price: 0, tokens: 10000, description: 'First month only' },
            starter29: { name: 'Starter', price: 29, tokens: 5000, description: '~1,500 SMS or 5,000 emails' },
            starter49: { name: 'Growth', price: 49, tokens: 10000, description: '~3,000 SMS or 10,000 emails' },
            professional: { name: 'Professional', price: 199, tokens: 50000, description: '~15,000 SMS or 50,000 emails' },
            enterprise: { name: 'Enterprise', price: 499, tokens: 150000, description: '~50,000 SMS or 150,000 emails' },
            platinum: { name: 'Platinum', price: 1000, tokens: 300000, description: '~100,000 SMS or 300,000 emails' }
        };

        function recommendPlan(totalTokens) {
            if (totalTokens <= 5000) return 'starter29';
            if (totalTokens <= 10000) return 'starter49';
            if (totalTokens <= 50000) return 'professional';
            if (totalTokens <= 150000) return 'enterprise';
            return 'platinum';
        }

        // All DOM-dependent code wrapped in DOMContentLoaded
        document.addEventListener('DOMContentLoaded', function() {
            // Load wizard configuration if available
            const config = JSON.parse(sessionStorage.getItem('tilliConfig') || '{}');

            if (config.totalTokens && config.totalTokens > 0) {
                // Display plan summary from wizard
                // Use manually selected plan if available, otherwise calculate based on tokens
                const recommendedPlanKey = config.recommendedPlan || recommendPlan(config.totalTokens);
                const recommendedPlan = PLANS[recommendedPlanKey];

                const planSummaryHTML = `
                    <div class="plan-summary">
                        <div class="plan-summary-header">
                            <div class="plan-name">${recommendedPlan.name} Plan</div>
                            <div class="plan-price">$${recommendedPlan.price}<span style="font-size: 1rem; font-weight: 600;">/mo</span></div>
                        </div>

                        <div class="plan-details">
                            <div class="plan-detail-row">
                                <span class="plan-detail-label">Monthly Tokens</span>
                                <span class="plan-detail-value">${config.totalTokens.toLocaleString()} tokens needed</span>
                            </div>
                            <div class="plan-detail-row">
                                <span class="plan-detail-label">Services Selected</span>
                                <span class="plan-detail-value">${config.services.length} services</span>
                            </div>
                            <div class="plan-detail-row">
                                <span class="plan-detail-label">Monthly Savings</span>
                                <span class="plan-detail-value" style="color: #10b981;">$${Math.round(config.totalSavings)}/mo</span>
                            </div>
                            <div class="plan-detail-row">
                                <span class="plan-detail-label">Annual Savings</span>
                                <span class="plan-detail-value" style="color: #10b981;">$${Math.round(config.totalSavings * 12).toLocaleString()}/year</span>
                            </div>
                        </div>

                        <div class="free-trial-badge">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="width: 16px; height: 16px;">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                            </svg>
                            First 10,000 Tokens FREE This Month
                        </div>

                        <div class="benefits-list">
                            <div class="benefit-item">
                                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                </svg>
                                No credit card required
                            </div>
                            <div class="benefit-item">
                                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                </svg>
                                Cancel anytime
                            </div>
                            <div class="benefit-item">
                                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                </svg>
                                Setup in minutes
                            </div>
                            <div class="benefit-item">
                                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                </svg>
                                24/7 support
                            </div>
                        </div>
                    </div>
                `;

                document.getElementById('plan-summary-container').innerHTML = planSummaryHTML;
            }

            // Pre-fill from URL parameters (highest priority)
            const urlParams = new URLSearchParams(window.location.search);
            const urlEmail = urlParams.get('email');
            const urlPhone = urlParams.get('phone');
            const urlFirstName = urlParams.get('firstName') || urlParams.get('firstname');
            const urlLastName = urlParams.get('lastName') || urlParams.get('lastname');
            const urlCompany = urlParams.get('company') || urlParams.get('companyName');

            // Pre-fill from localStorage (medium priority - from demos/calculators)
            const storedEmail = localStorage.getItem('demo_email');
            const storedPhone = localStorage.getItem('demo_phone');
            const storedFirstName = localStorage.getItem('demo_firstName');
            const storedLastName = localStorage.getItem('demo_lastName');
            const storedCompany = localStorage.getItem('demo_company');

            // Pre-fill from session storage (lowest priority - from OTP verification)
            const verifiedEmail = sessionStorage.getItem('verified_email');
            const verifiedPhone = sessionStorage.getItem('verified_phone');

            // Email - URL params take precedence over localStorage over sessionStorage
            const emailValue = urlEmail || storedEmail || verifiedEmail;
            if (emailValue) {
                document.getElementById('email').value = emailValue;
                if (verifiedEmail && emailValue === verifiedEmail) {
                    document.getElementById('email-verified-badge').style.display = 'inline-flex';
                }
            }

            // Phone - URL params take precedence over localStorage over sessionStorage
            const phoneValue = urlPhone || storedPhone || verifiedPhone;
            if (phoneValue) {
                document.getElementById('phone').value = phoneValue;
                if (verifiedPhone && phoneValue === verifiedPhone) {
                    document.getElementById('phone-verified-badge').style.display = 'inline-flex';
                }
            }

            // First Name
            const firstNameValue = urlFirstName || storedFirstName;
            if (firstNameValue) {
                document.getElementById('firstName').value = firstNameValue;
            }

            // Last Name
            const lastNameValue = urlLastName || storedLastName;
            if (lastNameValue) {
                document.getElementById('lastName').value = lastNameValue;
            }

            // Company Name
            const companyValue = urlCompany || storedCompany;
            if (companyValue) {
                document.getElementById('companyName').value = companyValue;
            }

            // Clear localStorage after pre-filling (one-time use)
            if (storedEmail || storedPhone || storedFirstName || storedLastName || storedCompany) {
                localStorage.removeItem('demo_email');
                localStorage.removeItem('demo_phone');
                localStorage.removeItem('demo_firstName');
                localStorage.removeItem('demo_lastName');
                localStorage.removeItem('demo_company');
            }

            // Validate commercial email
            document.getElementById('email').addEventListener('blur', function() {
                const email = this.value.toLowerCase();
                const domain = email.split('@')[1];

                if (domain && CONSUMER_EMAIL_DOMAINS.includes(domain)) {
                    this.classList.add('error');
                    return false;
                } else {
                    this.classList.remove('error');
                    return true;
                }
            });

            // Password validation with real-time feedback
            const passwordInput = document.getElementById('password');
            const confirmPasswordInput = document.getElementById('confirmPassword');

            function validatePassword(password) {
                const requirements = {
                    length: password.length >= 8,
                    uppercase: /[A-Z]/.test(password),
                    lowercase: /[a-z]/.test(password),
                    number: /[0-9]/.test(password),
                    special: /[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(password)
                };

                // Update UI for each requirement
                document.getElementById('req-length').style.color = requirements.length ? '#10b981' : '#6b7280';
                document.getElementById('req-uppercase').style.color = requirements.uppercase ? '#10b981' : '#6b7280';
                document.getElementById('req-lowercase').style.color = requirements.lowercase ? '#10b981' : '#6b7280';
                document.getElementById('req-number').style.color = requirements.number ? '#10b981' : '#6b7280';
                document.getElementById('req-special').style.color = requirements.special ? '#10b981' : '#6b7280';

                return Object.values(requirements).every(Boolean);
            }

            passwordInput.addEventListener('input', function() {
                validatePassword(this.value);
            });

            confirmPasswordInput.addEventListener('input', function() {
                const matchError = document.getElementById('password-match-error');
                if (this.value && this.value !== passwordInput.value) {
                    matchError.style.display = 'block';
                } else {
                    matchError.style.display = 'none';
                }
            });

            // OAuth button handlers
            const AUTH_SERVICE_URL = 'http://localhost:3100';

            // QuickBooks OAuth
            document.getElementById('oauth-quickbooks').addEventListener('click', function() {
                console.log('[OAUTH] QuickBooks login initiated');
                window.location.href = `${AUTH_SERVICE_URL}/api/auth/quickbooks/signin`;
            });

            // Salesforce OAuth
            document.getElementById('oauth-salesforce').addEventListener('click', function() {
                console.log('[OAUTH] Salesforce login initiated');
                window.location.href = `${AUTH_SERVICE_URL}/api/auth/salesforce/signin`;
            });

            // HubSpot OAuth
            document.getElementById('oauth-hubspot').addEventListener('click', function() {
                console.log('[OAUTH] HubSpot login initiated');
                window.location.href = `${AUTH_SERVICE_URL}/api/auth/hubspot/signin`;
            });

            // Shopify OAuth
            document.getElementById('oauth-shopify').addEventListener('click', function() {
                const shopDomain = prompt('Enter your Shopify store domain (e.g., mystore.myshopify.com):');
                if (shopDomain) {
                    console.log('[OAUTH] Shopify login initiated for:', shopDomain);
                    window.location.href = `${AUTH_SERVICE_URL}/api/auth/shopify/signin?shop=${encodeURIComponent(shopDomain)}`;
                }
            });

            // Google OAuth
            document.getElementById('oauth-google').addEventListener('click', function() {
                console.log('[OAUTH] Google login initiated');
                window.location.href = `${AUTH_SERVICE_URL}/api/auth/sign-in/social/google`;
            });

            // Microsoft OAuth
            document.getElementById('oauth-microsoft').addEventListener('click', function() {
                console.log('[OAUTH] Microsoft login initiated');
                window.location.href = `${AUTH_SERVICE_URL}/api/auth/sign-in/social/microsoft`;
            });

            // GitHub OAuth
            document.getElementById('oauth-github').addEventListener('click', function() {
                console.log('[OAUTH] GitHub login initiated');
                window.location.href = `${AUTH_SERVICE_URL}/api/auth/sign-in/social/github`;
            });

            // Passwordless signup
            document.getElementById('passwordless-btn').addEventListener('click', async function() {
                const email = prompt('Enter your email address:');

                if (!email || !email.includes('@')) {
                    alert('Please enter a valid email address');
                    return;
                }

                console.log('[PASSWORDLESS] Initiating passwordless signup for:', email);

                try {
                    const response = await fetch(`${AUTH_SERVICE_URL}/api/auth/signup/passwordless`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            email: email,
                            firstName: email.split('@')[0] || 'User',
                            lastName: '',
                        })
                    });

                    const result = await response.json();

                    if (result.success) {
                        showAlert('Check your email! We sent you a magic link to sign in.', 'success');

                        // In development, show the magic link
                        if (result.devMagicLink) {
                            console.log('Magic Link:', result.devMagicLink);
                            if (confirm('Development mode: Would you like to open the magic link now?')) {
                                window.location.href = result.devMagicLink;
                            }
                        }
                    } else {
                        showAlert(result.error || 'Failed to send magic link', 'error');
                    }
                } catch (error) {
                    console.error('[PASSWORDLESS] Error:', error);
                    showAlert('Failed to send magic link. Please try again.', 'error');
                }
            });

            // OAuth button hover effects
            document.querySelectorAll('.oauth-btn').forEach(btn => {
                btn.addEventListener('mouseenter', function() {
                    this.style.borderColor = '#4099FF';
                    this.style.boxShadow = '0 4px 6px rgba(64, 153, 255, 0.15)';
                    this.style.transform = 'translateY(-2px)';
                });
                btn.addEventListener('mouseleave', function() {
                    this.style.borderColor = '#e5e7eb';
                    this.style.boxShadow = 'none';
                    this.style.transform = 'translateY(0)';
                });
            });

            // Form submission
            document.getElementById('signup-form').addEventListener('submit', async function(e) {
            e.preventDefault();
            console.log('[SIGNUP] Form submission started');

            const submitBtn = this.querySelector('.submit-btn');
            const alertContainer = document.getElementById('alert-container');

            // Validate email
            const emailInput = document.getElementById('email');
            const email = emailInput.value.toLowerCase();
            const domain = email.split('@')[1];
            console.log('[SIGNUP] Validating email:', email, 'domain:', domain);

            if (domain && CONSUMER_EMAIL_DOMAINS.includes(domain)) {
                console.log('[SIGNUP] Email validation failed - consumer domain');
                emailInput.classList.add('error');
                showAlert('Please use your company email address, not a personal email.', 'error');
                return;
            }

            // Validate password
            const password = document.getElementById('password').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            console.log('[SIGNUP] Validating password requirements');

            if (!validatePassword(password)) {
                console.log('[SIGNUP] Password validation failed');
                showAlert('Please ensure your password meets all requirements.', 'error');
                document.getElementById('password').focus();
                return;
            }

            if (password !== confirmPassword) {
                console.log('[SIGNUP] Password mismatch');
                showAlert('Passwords do not match. Please re-enter your password.', 'error');
                document.getElementById('confirmPassword').focus();
                return;
            }

            // Get selected products
            const selectedProducts = Array.from(document.querySelectorAll('input[name="products"]:checked'))
                .map(cb => cb.value);
            console.log('[SIGNUP] Selected products:', selectedProducts);

            if (selectedProducts.length === 0) {
                console.log('[SIGNUP] No products selected');
                showAlert('Please select at least one product to sign up for.', 'error');
                return;
            }

            // Get selected connectors (optional) - one per category
            const selectedConnectors = {
                crm: document.querySelector('input[name="connector-crm"]:checked')?.value || null,
                erp: document.querySelector('input[name="connector-erp"]:checked')?.value || null,
                accounting: document.querySelector('input[name="connector-accounting"]:checked')?.value || null
            };
            // Filter out empty values
            const connectors = Object.entries(selectedConnectors)
                .filter(([key, value]) => value && value !== '')
                .reduce((obj, [key, value]) => ({ ...obj, [key]: value }), {});
            console.log('[SIGNUP] Selected connectors:', connectors);

            // Get wizard configuration if available
            const wizardConfig = JSON.parse(sessionStorage.getItem('tilliConfig') || '{}');
            let recommendedPlan = null;
            if (wizardConfig.totalTokens && wizardConfig.totalTokens > 0) {
                const planKey = recommendPlan(wizardConfig.totalTokens);
                recommendedPlan = {
                    planKey: planKey,
                    planName: PLANS[planKey].name,
                    planPrice: PLANS[planKey].price,
                    totalTokens: wizardConfig.totalTokens,
                    services: wizardConfig.services,
                    monthlySavings: wizardConfig.totalSavings,
                    annualSavings: wizardConfig.totalSavings * 12
                };
            }

            // Collect form data
            const formData = {
                firstName: document.getElementById('firstName').value,
                lastName: document.getElementById('lastName').value,
                email: document.getElementById('email').value,
                phone: document.getElementById('phone').value,
                companyName: document.getElementById('companyName').value,
                industry: document.getElementById('industry').value,
                companySize: document.getElementById('companySize').value,
                password: password,
                products: selectedProducts,
                connectors: connectors,
                recommendedPlan: recommendedPlan,
                source: recommendedPlan ? 'pricing_wizard' : 'website_signup',
                timestamp: new Date().toISOString()
            };

            console.log('[SIGNUP] Form data collected:', { ...formData, password: '***' });

            // Disable submit button
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin" style="margin-right: 0.5rem;"></i> Processing...';

            try {
                console.log('[SIGNUP] Sending to /api/signup...');

                // Send to CRM (existing functionality)
                const crmResponse = await fetch('/api/signup', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });

                console.log('[SIGNUP] CRM Response status:', crmResponse.status);
                const crmResult = await crmResponse.json();
                console.log('[SIGNUP] CRM Response data:', crmResult);

                if (!crmResult.success) {
                    console.log('[SIGNUP] CRM signup failed:', crmResult.error);
                    showAlert(crmResult.error || 'Something went wrong. Please try again.', 'error');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fas fa-rocket" style="margin-right: 0.5rem;"></i> Start Free Trial';
                    return;
                }

                // Store automation results for success page
                if (crmResult.automations) {
                    sessionStorage.setItem('signup_automations', JSON.stringify(crmResult.automations));
                }

                // Now create account in Nudge/tilliPay (if those products are selected)
                const shouldCreateNudgeAccount = selectedProducts.some(p =>
                    ['nudge', 'tillipay', 'tillix'].includes(p.toLowerCase())
                );

                if (shouldCreateNudgeAccount) {
                    console.log('[SIGNUP] Creating unified Tilli account...');

                    // Prepare data for Nudge onboarding API
                    const nudgeSignupData = {
                        email: formData.email,
                        password: formData.password,
                        firstName: formData.firstName,
                        lastName: formData.lastName,
                        phoneNumber: formData.phone,
                        companyName: formData.companyName,
                        industry: formData.industry,
                        companySize: formData.companySize,
                        selectedProducts: formData.products,
                        monthlyVolume: recommendedPlan?.totalTokens || 5000,
                        referralSource: 'tillisoftware.com',
                        whiteLabel: 'tillisoftware.com'
                    };

                    try {
                        // Call Nudge unified onboarding API
                        // For local development: http://localhost:5000/api/v2/Onboarding/CreateAccount
                        // For production: https://api.tillisoftware.com/api/v2/Onboarding/CreateAccount
                        const nudgeApiUrl = window.location.hostname === 'localhost'
                            ? 'http://localhost:5000/api/v2/Onboarding/CreateAccount'
                            : 'https://api.tillisoftware.com/api/v2/Onboarding/CreateAccount';

                        console.log('[SIGNUP] Calling Nudge API:', nudgeApiUrl);

                        const nudgeResponse = await fetch(nudgeApiUrl, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include', // Important for cookies
                            body: JSON.stringify(nudgeSignupData)
                        });

                        console.log('[SIGNUP] Nudge API Response status:', nudgeResponse.status);
                        const nudgeResult = await nudgeResponse.json();
                        console.log('[SIGNUP] Nudge API Response data:', nudgeResult);

                        if (nudgeResult.data && nudgeResult.data.success) {
                            console.log('[SIGNUP] Nudge account created successfully!');
                            console.log('[SIGNUP] Redirecting to:', nudgeResult.data.redirectUrl);

                            // Show success message
                            showAlert('Success! Your account has been created. Redirecting to your dashboard...', 'success');

                            // Redirect to Nudge welcome page (auto-login)
                            // The redirectUrl includes the JWT token for auto-login
                            setTimeout(() => {
                                window.location.href = nudgeResult.data.redirectUrl;
                            }, 2000);
                            return; // Exit here, no need to redirect to success page
                        } else {
                            console.log('[SIGNUP] Nudge account creation failed, using fallback');
                            // Fallback: still redirect to success page if Nudge creation fails
                        }
                    } catch (nudgeError) {
                        console.error('[SIGNUP] Nudge API error:', nudgeError);
                        // Fallback: continue to success page even if Nudge fails
                    }
                }

                // Default fallback: redirect to success page
                console.log('[SIGNUP] Success! Redirecting to success page...');
                showAlert('Success! Your account is being created. Check your email for next steps.', 'success');

                setTimeout(() => {
                    console.log('[SIGNUP] Redirecting now...');
                    window.location.href = '/signup-success.html';
                }, 2000);

            } catch (error) {
                console.error('[SIGNUP] Network error:', error);
                showAlert('Network error. Please check your connection and try again.', 'error');
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-rocket" style="margin-right: 0.5rem;"></i> Start Free Trial';
            }
            });

            function showAlert(message, type) {
                const alertContainer = document.getElementById('alert-container');
                alertContainer.innerHTML = `
                    <div class="alert ${type} show">
                        <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'}"></i>
                        ${message}
                    </div>
                `;

                // Scroll to alert
                alertContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        });
    </script>


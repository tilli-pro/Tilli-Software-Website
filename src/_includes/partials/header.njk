<header class="header">
  <!-- Top Banner -->
  <div style="width: 100%; background: linear-gradient(90deg, #4169E1 0%, #00BFFF 100%); padding: 18px 20px; text-align: center; display: flex; align-items: center; justify-content: center; gap: 16px; z-index: 1001; height: 62px; box-sizing: border-box;">
    <span style="font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 400; color: #FFFFFF;">✨Join us for our upcoming webinar on the future of digital payments.</span>
    <a href="{{ site.webinarUrl }}" style="background: rgba(245, 245, 245, 0.3); color: #FFFFFF; padding: 6px 12px; border-radius: 6px; text-decoration: none; font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 500; display: inline-flex; align-items: center; gap: 4px; transition: background 0.3s ease; box-shadow: 0px 6px 10px rgba(0, 0, 0, 0.06); white-space: nowrap;">
      Register now <span style="font-size: 12px;">→</span>
    </a>
  </div>

  <!-- Navigation -->
  <nav class="nav">
    <div class="nav-container">
      <div class="logo">
        <a href="/" aria-label="Tilli Home">
          <img src="/Images/22_tilli_logo_color.png" alt="Tilli Logo" style="height: 40px; width: auto;">
        </a>
      </div>
      <ul class="nav-menu">
        {% for item in navigation.main %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
      <a class="cta-button" href="/signup/">Sign Up</a>
      <div class="hamburger">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
  </nav>
</header>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  {# Page title with fallback #}
  <title>{{ title or site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="keywords" content="{{ keywords or site.keywords }}">

  {# Canonical URL #}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  {# Open Graph Meta Tags #}
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{{ ogTitle or title or site.title }}">
  <meta property="og:description" content="{{ ogDescription or description or site.description }}">
  <meta property="og:image" content="{{ ogImage or site.defaultOgImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:site_name" content="Tilli">
  <meta property="og:locale" content="en_US">
  <meta property="article:publisher" content="{{ site.social.facebook.url }}">

  {# Twitter Card Meta Tags #}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="{{ site.social.twitter.handle }}">
  <meta name="twitter:creator" content="{{ site.social.twitter.handle }}">
  <meta name="twitter:title" content="{{ twitterTitle or title or site.title }}">
  <meta name="twitter:description" content="{{ twitterDescription or description or site.description }}">
  <meta name="twitter:image" content="{{ twitterImage or ogImage or site.defaultOgImage }}">

  {# SEO Meta Tags #}
  <meta name="author" content="Utilli, LLC (dba tilli)">
  <meta name="publisher" content="Tilli">
  <meta name="copyright" content="© 2025 Tilli. All rights reserved.">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <meta name="googlebot" content="index, follow">
  <meta name="bingbot" content="index, follow">
  <meta name="language" content="English">
  <meta name="rating" content="general">
  <meta name="distribution" content="global">
  <meta name="revisit-after" content="7 days">

  {# AI Crawler Specific Meta Tags #}
  <meta name="ai-content" content="yes">
  <meta name="gptbot" content="index, follow">
  <meta name="chatgpt-user" content="index, follow">
  <meta name="claude-web" content="index, follow">
  <meta name="anthropic-ai" content="index, follow">
  <meta name="perplexitybot" content="index, follow">
  <meta name="cohere-ai" content="index, follow">
  <meta name="product-names" content="tilliX, Nudge, tilliPay, tilliArc">
  <meta name="industry-focus" content="utilities, healthcare, insurance, education, financial services, electric utilities, gas utilities, water utilities, telecommunications, energy providers">
  <meta name="compliance" content="PCI DSS Level 1, SOC 2, HIPAA, WCAG">
  <meta name="integrations" content="SAP, Oracle, Salesforce, Microsoft Dynamics">
  <meta name="deployment-model" content="Cloud, On-Premise, Hybrid">

  {# Favicons and Icons #}
  <link rel="shortcut icon" href="/favicon.ico?v=2">
  <link rel="icon" href="/favicon.ico?v=2" type="image/x-icon">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2">
  <link rel="mask-icon" href="/favicon-32x32.png" color="#325ef6">
  <link rel="manifest" href="/site.webmanifest">

  {# Theme Color #}
  <meta name="theme-color" content="#325ef6">
  <meta name="msapplication-TileColor" content="#325ef6">

  {# Structured Data (if provided) #}
  {% if structuredData %}
    <script type="application/ld+json">{{ structuredData | jsonify | safe }}</script>
  {% endif %}

  {# Stylesheets #}
  <link rel="stylesheet" href="/styles.css">

  {# Google Fonts #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;600;700&family=Inter:wght@300;400;500;600;700&family=Lato:wght@300;400;700&family=Manrope:wght@300;400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  {# Font Awesome #}
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

  {# Cookie Consent CSS #}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@v2.9.2/dist/cookieconsent.css">

  {# Vercel Analytics #}
  <script defer src="/_vercel/insights/script.js"></script>
</head>

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-links">
        <div class="footer-column">
          <h4>Products</h4>
          <ul>
            {% for item in navigation.footer.products %}
              <li><a href="{{ item.url }}">{{ item.label }}</a></li>
            {% endfor %}
          </ul>
        </div>

        <div class="footer-column">
          <h4>Resources</h4>
          <ul>
            {% for item in navigation.footer.resources %}
              <li><a href="{{ item.url }}">{{ item.label }}</a></li>
            {% endfor %}
          </ul>
        </div>

        <div class="footer-column">
          <h4>Developers</h4>
          <ul>
            {% for item in navigation.footer.developers %}
              <li><a href="{{ item.url }}">{{ item.label }}</a></li>
            {% endfor %}
          </ul>
        </div>

        <div class="footer-column">
          <h4>Company</h4>
          <ul>
            {% for item in navigation.footer.company %}
              <li><a href="{{ item.url }}">{{ item.label }}</a></li>
            {% endfor %}
          </ul>
        </div>

        <div class="footer-column">
          <h4>Get Started Today</h4>
          <ul>
            <li><a href="/free-trial/" class="gradient-link">Start a Free Trial <span class="arrow">→</span></a></li>
            <li><a href="/contact/" class="gradient-link">Request a Demo <span class="arrow">→</span></a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <div class="footer-brand">
          <div class="footer-logo">
            <img src="/Images/22_Utilli_logo_white.png" alt="Tilli Logo">
          </div>
          <p>{{ site.tagline }} - A comprehensive financial solutions platform that helps businesses automate payments, streamline billing, and enhance customer engagement through secure, cloud-based technology.</p>
          <p class="footer-copyright">&copy; 2025 Tilli — Copyright All Rights reserved</p>
        </div>

        <div class="footer-right">
          <div class="footer-status">
            <span class="status-indicator"></span>
            <span>Platform status</span>
          </div>
          <div class="footer-social">
            <a href="{{ site.social.twitter.url }}" target="_blank" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
            <a href="{{ site.social.instagram.url }}" target="_blank" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
            <a href="{{ site.social.facebook.url }}" target="_blank" aria-label="Facebook"><i class="fab fa-facebook"></i></a>
            <a href="{{ site.social.youtube.url }}" target="_blank" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
            <a href="{{ site.social.linkedin.url }}" target="_blank" aria-label="LinkedIn"><i class="fab fa-linkedin"></i></a>
          </div>
          <div class="footer-legal-links">
            {% for item in navigation.footer.legal %}
              <a href="{{ item.url }}">{{ item.label }}</a>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  // Footer gradient border mouse tracking
  const footer = document.querySelector('.footer');
  if (footer) {
    footer.addEventListener('mousemove', (e) => {
      const rect = footer.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      footer.style.setProperty('--mouse-x', `${x}%`);
    });
  }
</script>
